# voicebot - Environment Variables
# Copy this file to .env and fill in your API keys



# Whisper (STT)
# Optional: defaults to Systran/faster-distil-whisper-medium.en
# WHISPER_MODEL=

# Groq (LLM + STT, preferred — replaces local Ollama and local Whisper when set)
# Get a key at console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=
GROQ_STT_MODEL=

# Optional: separate Groq key for STT, so one key isn't serving both the LLM and
# the transcription. Blank = use GROQ_API_KEY for both.
GROQ_STT_API_KEY=

# Free-tier budget is metered per KEY (measured), and bot.py rotates through every
# GROQ_*_API_KEY on a 429 — so each key here is another 8000 tokens/minute, worth
# ~2.3 turns. A booking call needs 6-10 turns/min, i.e. three keys.
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=

# Google AI Studio (Gemini) — a bucket from a different provider, so it does not
# compete with the Groq minute. Get a key at aistudio.google.com/apikey
# Cascade LLM only for now (keeps Sarvam TTS + the GuardFilter). Gemini Live
# S2S is deliberately NOT used: it pushes audio straight from the LLM, so no text
# checkpoint exists before the caller hears it.
GOOGLE_API_KEY=
GOOGLE_MODEL=

# Ollama (LLM, local fallback — used only if GROQ_API_KEY is unset)
OLLAMA_MODEL=

# Piper (TTS, local fallback — used only if ELEVENLABS_API_KEY is unset)
PIPER_VOICE_ID=

# Sarvam AI (TTS) — used whenever SARVAM_API_KEY is set, ahead of ElevenLabs.
# SARVAM_VOICE picks the speaker. Verified against the API 2026-09-15, bulbul:v3
# accepts exactly these nine female voices and rejects anything else:
#   ritu  priya  neha  pooja  simran  kavya  ishita  shreya  roopa
# Blank = shreya (aligned with the liveagents harness). There is no "monika"
# speaker; Monika is the persona's name.
SARVAM_VOICE=
SARVAM_MODEL=
# Speech speed, 0.5-2.0. Blank = 1.0. 1.08 read as curt/rude on live calls
# (2026-09-23). Past ~1.3 consonants smear.
SARVAM_PACE=
# Prosody randomness for bulbul:v3 only (0.01-1.0). Blank = 0.15. 0.35 sounded
# more like an AI bot (A/B by ear, 2026-09-23).
# HIGH values (Sarvam default 0.6) draw a new tone/volume PER CHUNK — that is the
# "different voice every sentence" / shouting bug. Pitch/loudness are v2-only.
SARVAM_TEMPERATURE=
# WebSocket chunking. Bigger = fewer temperature draws = more consistent voice.
# Blank = 80 / 500, matching liveagents (Documents/using liveagents) — that
# harness does not show the "voice shifts mid-reply" complaint at these
# values; 300 here still did, on a live call 2026-09-22. Defaults in Pipecat
# are 50 / 150. Pitch/loudness are NOT the lever — confirmed against the
# installed pipecat.services.sarvam.tts source: ignored entirely on bulbul:v3.
SARVAM_MIN_BUFFER=
SARVAM_MAX_CHUNK=

# ElevenLabs (TTS, used only when SARVAM_API_KEY is unset)
# Get a key at elevenlabs.io -> Profile -> API Keys
# NOTE: on a FREE plan the API refuses every Voice Library voice with
# 402 paid_plan_required — "Free users cannot use library voices via the API".
# That includes "Monika Sogam" (zmh5xhBvMzqR4ZlXgcgL), which works in the
# elevenlabs.io playground but not from here. Stock voices do work.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=


# Park+ self-hosted vLLM. Set the URL to put it FIRST in the LLM rotation —
# no quota, no per-minute bucket, TTFT ~0.70s measured. Unset, nothing changes.
# REQUIRES the server to be started with tool calling enabled:
#   --enable-auto-tool-choice --tool-call-parser hermes
# Without those flags every request 400s and the endpoint retires itself.
# No -k / verify=False: TLS validates on this host, and the call carries phone numbers.
PARKPLUS_LLM_URL=
PARKPLUS_LLM_MODEL=
PARKPLUS_LLM_API_KEY=

# on (default) | off — off disables function calling: no booking capture, no
# human handover, no end_call tool. Only for a backend that cannot serve tools.
# Hangup then relies on CALL_MAX_SECS / CALL_IDLE_SECS only.
LLM_TOOLS=

# --- Call safety (PSTN) -------------------------------------------------------
# Hard cap on call length, seconds. Blank = 360. 0 = disable. Arms on each greet.
CALL_MAX_SECS=
# No BotSpeaking / transcription / user-speech for this many seconds → nudge,
# and hang up once the nudges are spent. Blank = 300 (Pipecat default; safe for
# evals). Use 90 on live PSTN so a mute pipeline or off-hook handset stops
# billing. 0 = disable.
CALL_IDLE_SECS=
# How many times a silent line is asked before it is dropped. Blank = 2.
# Silence here usually means they are TYPING THE FORM — which takes far longer
# than 90s — so dropping on the first timeout hung up on customers mid-KYC
# (call.log, 2026-09-21). 0 restores the old drop-on-first-timeout behaviour.
CALL_IDLE_NUDGES=

# --- Telephony: Exotel (preferred) or Plivo — Indian CLI / 1600-series --------
# Exotel (no Answer XML): App Bazaar → Voicebot applet → WebSocket URL:
#   wss://<ngrok-host>/ws
# Run:  python bot.py -t exotel
# Needs ngrok (or similar) in front of localhost:7860. No Exotel API keys in
# the bot for dial-in media stream.
#
# Plivo (parked): needs Answer URL POST + PLIVO_AUTH_ID / PLIVO_AUTH_TOKEN.
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=

# Voice activity detection. Room-and-microphone numbers — tune on a real call.
# Raise VAD_CONFIDENCE / VAD_MIN_VOLUME if background noise is picked up as
# speech; lower them if a soft speaker gets ignored. Blank = 0.85 / 0.6.
VAD_CONFIDENCE=
VAD_MIN_VOLUME=
VAD_START_SECS=

# Park+ self-hosted speech-to-text (flex-chunk). Set to use it instead of
# AssemblyAI — no per-minute billing, no third-party quota.
#   wss://speech-to-text.parkplus.io/asr
# NOTE: it returns ROMANISED Hindi ("Haan ji meri creta hai"), not Devanagari.
PARKPLUS_STT_URL=

# Park+ Bifrost gateway -> Gemini on Park+ billing. Virtual key, x-bf-vk header.
# Model ids are namespaced: gemini/gemini-3.6-flash
BIFROST_VK=
BIFROST_MODELS=
BIFROST_URL=

# Which business this process sells. car_spa | insurance (default car_spa)
DOMAIN=

# Sampling for the LLM. Park+ Ornith defaults (quality over speed):
#   LLM_TEMPERATURE=0.1  LLM_TOP_P=0.85  LLM_FREQUENCY_PENALTY=0.4
#   MAX_REPLY_TOKENS=500  LLM_REQUEST_TIMEOUT=25
# At higher temperature Ornith paraphrases scripts (waiting line instead of the
# details list). frequency_penalty cuts the same-line loop. Thinking stays OFF
# via chat_template_kwargs — do not raise MAX_REPLY to "let it think".
LLM_TEMPERATURE=
LLM_TOP_P=
LLM_FREQUENCY_PENALTY=
# Gemini/Bifrost rejects frequency_penalty ("Penalty is not enabled for this
# model"). Leave blank on Gemini. Only set for Park+ Ornith (e.g. 0.4).
#
# CUTOFF bug, 2026-09-21: raised 280 -> 500. Replies were truncating
# mid-sentence with BOTH Sarvam and AssemblyAI as STT, proving the cap (not
# turn-taking) was the cause. bot.py now logs "LLM TRUNCATED" when
# finish_reason="length" confirms it on a live call.
MAX_REPLY_TOKENS=
LLM_REQUEST_TIMEOUT=
# Gemini 3 / gpt-oss: use low (none is rejected or silently ignored).
# qwen: none is fine. Blank = per-model default in bot.py.
LLM_REASONING_EFFORT=

# A SECOND Bifrost virtual key, for the eval harness only.
#
# The judge and the simulated caller are test traffic, not the product. On
# 2026-09-19 they shared BIFROST_VK with the bot: 2,043 bot turns and 2,037
# judge calls in one day, 9.7M input tokens, ending in
#   402 budget_exceeded: 10.0045 >= 10.0000 dollars
# after which the BOT had nothing to answer with. The money was not the problem
# — a test run taking the phone line down is. Give the harness its own key and
# its own cap and the worst an eval binge can do is stop the evals.
#
# Unset, the judge still uses BIFROST_VK and warns once per run.
BIFROST_EVAL_VK=

# Force the judge off Bifrost entirely (values: bifrost, parkplus). Useful when
# the key is spent: without it every scenario fails "judge call failed:
# APIStatusError" while the bot is healthy on its Park+ fallback, which reads
# exactly like a broken bot. Park+ judges less decisively, so treat its verdicts
# as a smoke test rather than a gate.
JUDGE_BACKEND=

# --- AssemblyAI turn detection & noise -----------------------------------------
# Defaults live in bot.py; these only override them. Read the block there first —
# turn ends belong to AssemblyAI now (vad_force_turn_endpoint=False), not to
# Pipecat's smart-turn analyzer, and that needs a U3 Pro model.
#
# Noise playbook (AssemblyAI Voice Focus docs):
#   Browser / laptop → near-field (far-field PULLS IN distant room talk).
#   Still hearing far people → raise VOICE_FOCUS_THRESHOLD toward 1.0 and
#   raise VAD_THRESHOLD with VAD_CONFIDENCE together.
ASSEMBLYAI_MODEL=                    # universal-3-5-pro (default). U3 Pro family only.
ASSEMBLYAI_VOICE_FOCUS=              # near-field (default) for laptop/handset;
                                     # far-field only if the caller IS distant.
ASSEMBLYAI_VOICE_FOCUS_THRESHOLD=    # 1.0 default. Higher = more room suppression.
ASSEMBLYAI_VAD_THRESHOLD=            # 0.92. Keep ALIGNED with VAD_CONFIDENCE.
# SPEED, 2026-09-21: min/max_turn_silence and interruption_delay had drifted
# past AssemblyAI's own "balanced" numbers (500/1800/600) while ASSEMBLYAI_MODE
# still said balanced — up to 900ms of pure wait, before Bifrost or Sarvam ever
# see the request. Back to AssemblyAI's vetted balanced defaults; not invented.
# Callers cut off mid-sentence again → raise MAX_TURN_SILENCE first.
ASSEMBLYAI_INTERRUPTION_DELAY=       # unset = AssemblyAI's own mode default
                                     # (500ms on balanced, 0 on min_latency).
ASSEMBLYAI_MIN_TURN_SILENCE=         # 100ms before a turn may end.
ASSEMBLYAI_MAX_TURN_SILENCE=         # 1000ms hard ceiling on a turn.
ASSEMBLYAI_MODE=                     # balanced (default) | min_latency | max_accuracy
ASSEMBLYAI_CONTEXT_PROMPT=           # 1 to send our own context prompt from
                                     # context.json's stt_prompt. OFF by default.

# --- STT A/B: Sarvam realtime, 2026-09-21 -------------------------------------
# SARVAM_STT=1 tries Sarvam's realtime STT (SarvamRealtimeSTTService) instead of
# AssemblyAI. Same vendor/key as TTS. Checked before wiring: NO speculative/eager
# inference (same gap as AssemblyAI/Park+ — only Cartesia's STT has that mixin
# in this Pipecat build), NO keyterms list (only a free-text prompt, left unset
# — a custom one replaces Sarvam's own default), NO named noise-suppression
# feature like AssemblyAI's voice_focus. Connectivity verified live 2026-09-21;
# actual transcription quality/noise-handling on a real call is NOT.
#
# CUTOFF bug, 2026-09-21: a live call with this on had replies truncating
# mid-sentence — room noise (the caller's own "बहुत ज़्यादा ही साउंड आ रही है")
# crossed Sarvam's default threshold=0.3 and should_interrupt=True cut the bot
# off. Raised the default to 0.6 in bot.py; tune with SARVAM_STT_THRESHOLD.
SARVAM_STT=
SARVAM_STT_STREAM_TYPE=              # fast (default) | balanced | simulated

# --- WhatsApp KYC-link option, 2026-09-22 -------------------------------------
# OFF by default. Product ask: two parallel KYC paths — the app (existing,
# unchanged) and, only if the customer wants it, a WhatsApp message with ONLY
# the KYC link — never a document/photo request, never any other link. The
# actual send mechanism (how the bot's process triggers a real WhatsApp send)
# is not wired in this repo yet — that is separate, planned work. This flag
# only controls whether the PROMPT is allowed to offer/promise the link;
# domains/insurance/guard.py already has the matching sanctioned-line
# exemption. Do not turn this on before the real send path exists — the bot
# would go back to promising a message that never arrives, the exact failure
# mode this flag exists to prevent.
WHATSAPP_KYC_LINK=
SARVAM_STT_THRESHOLD=                # 0.6 default (Sarvam's own is 0.3, too
                                      # permissive for a noisy room — raise
                                      # further if turns still cut early).

# REPLY_SCRIPT=hinglish makes the bot write Hindi in Latin letters instead of
# Devanagari. Measured 2026-09-22: the same sentence is 87 prompt tokens in
# Devanagari and 55 in Hinglish on Park+'s Qwen tokenizer, and Sarvam bulbul:v3
# speaks the two identically (TTS -> STT round trip, 8 pairs, 7 byte-identical).
# Insurance only (its prompt and guard are romanised; car spa's are not).
# Gemini A/B 2026-09-23: 0/38 replies in Devanagari, same failures and latency,
# ~Rs 0.16/min more because Sarvam bills per character. Caller side stays
# Devanagari (that is what the STT returns). Blank = devanagari.
REPLY_SCRIPT=

# FILLER_DELAY_SECS: fire a non-lexical hum ("हम्म," / "उम्म,", randomised,
# never the same one twice in a row) ONLY once the LLM has already been
# silent for this many seconds — never before, so it never adds to the wait,
# only fills dead air that was already going to happen. 0/unset = OFF
# (default). Try 1.0-1.3s: median LLM turn is ~1.5-2s. Verified by TTS->STT
# round trip that Sarvam pronounces these as a hum, not a word — see
# FILLER_TIER1 in bot.py before changing the phrases.
#
# FILLER_DELAY2_SECS (optional): EXTRA seconds after that, if the reply is
# STILL not back, for a second, different phrase ("बस देख रही हूँ सर," /
# "एक सेकंड सर,") — a real person who is still working says something else
# the second time, not the same ack. 0/unset = single-ack behaviour only.
#
# Trial feature, 2026-09-22: verified with synthetic timing tests (never
# fires if the real reply beats the delay, tier 2 never fires if tier 1's
# reply already arrived, never double-logs LATENCY, a caller barging in
# cancels a still-pending filler, never repeats the same phrase back to
# back) — but sub-turn audio timing like this cannot be proven by the batch
# eval harness, only heard. Test on a real call before trusting it.
FILLER_DELAY_SECS=
FILLER_DELAY2_SECS=

# AssemblyAI language steering (streaming). Comma-separated, order matters —
# first code steers hardest. Default hi,en. Pipecat's `language` setting is NOT
# sent on streaming, so this is the only thing that steers the model's language.
ASSEMBLYAI_LANGUAGE_CODES=
